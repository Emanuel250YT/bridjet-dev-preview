# WalletConnect Project ID
# Get yours at: https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# 1inch API Key (for cross-chain swaps)
# Get yours at: https://portal.1inch.dev/
VITE_1INCH_API_KEY=your_1inch_api_key_here

# Private Key for wallet transactions (NEVER commit this!)
VITE_PRIVATE_KEY=0x...

# Bridjet API URL (if using API mode)
VITE_API_URL=https://api.your-backend.com

# Environment
NODE_ENV=development
